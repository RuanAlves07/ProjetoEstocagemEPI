# Configurações do Ambiente - Projeto Estoque de EPIs

# Porta onde o sistema ficará acessível no host
PORT=5000

# Fuso horário para os registros de data e hora
TZ=America/Sao_Paulo

# Chave secreta de sessão da aplicação (Gere uma chave segura, ex: openssl rand -hex 32)
# Se não preenchido, será gerado automaticamente dentro da pasta instance/secret_key
EPI_SECRET_KEY=

# Banco de Dados (Opcional)
# Se não configurado, o sistema usará automaticamente o SQLite persistente em instance/epi.sqlite
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco
